:root {
  --bg: #f4f7f2;
  --card: rgba(255, 255, 255, 0.8);
  --panel: #eef6ef;
  --primary: #4a9b6d;
  --primary-dark: #2d6d4d;
  --secondary: #dff1e4;
  --accent: #f7b267;
  --text: #1d2a22;
  --muted: #5d6d64;
  --line: rgba(66, 87, 72, 0.12);
  --shadow: 0 20px 50px rgba(30, 54, 44, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top, rgba(149, 221, 176, 0.25), transparent 30%),
    linear-gradient(180deg, #f8faf7 0%, #edf7f1 100%);
  color: var(--text);
}

button,
input {
  font: inherit;
}

button {
  border: none;
  border-radius: 14px;
  cursor: pointer;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

button:hover {
  transform: translateY(-1px);
}

img {
  display: block;
  max-width: 100%;
}

.app-shell {
  min-height: 100vh;
  padding: 24px;
}

.topbar {
  max-width: 1200px;
  margin: 0 auto 28px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10px);
  border: 1px solid var(--line);
  border-radius: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 24px;
  box-shadow: var(--shadow);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-badge {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--primary), #7ec99a);
  color: white;
  font-weight: 800;
}

.eyebrow {
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 11px;
  margin: 0 0 4px;
  font-weight: 700;
}

.brand-wrap h1,
.section-heading h3,
.hero-copy h2,
.profile-identity h4 {
  margin: 0;
}

.nav {
  display: flex;
  gap: 18px;
}

.nav a {
  text-decoration: none;
  color: var(--text);
  font-weight: 600;
}

.page {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  gap: 28px;
}

.card {
  background: var(--card);
  backdrop-filter: blur(14px);
  border: 1px solid var(--line);
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.hero {
  display: grid;
  grid-template-columns: 1.6fr 0.9fr;
  gap: 20px;
  padding: 32px;
}

.hero-copy {
  padding: 8px 10px 8px 0;
}

.hero-copy h2 {
  font-size: clamp(2.2rem, 4vw, 4rem);
  line-height: 1.02;
  margin-bottom: 14px;
  letter-spacing: -0.06em;
}

.hero-copy p {
  color: var(--muted);
  font-size: 1.04rem;
  max-width: 600px;
  margin: 0 0 26px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  gap: 14px;
  margin-bottom: 22px;
}

.primary,
.secondary {
  padding: 13px 20px;
  font-weight: 700;
}

.primary {
  background: linear-gradient(135deg, var(--primary), #6ec78b);
  color: white;
}

.secondary {
  background: var(--secondary);
  color: var(--primary-dark);
}

.secondary.small {
  padding: 10px 14px;
  font-size: 0.88rem;
}

.hero-points {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.hero-points li {
  background: #f2fbf4;
  color: var(--primary-dark);
  border: 1px solid rgba(74, 155, 109, 0.18);
  border-radius: 999px;
  padding: 9px 12px;
  font-size: 0.82rem;
  font-weight: 600;
}

.hero-panel {
  display: grid;
  gap: 14px;
  align-content: center;
}

.mini-card {
  border-radius: 22px;
  padding: 20px 18px;
  border: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(255,255,255,0.6), rgba(245, 249, 247, 1));
}

.stat-card {
  display: grid;
  gap: 6px;
}

.stat-card span,
.stat-card small,
.mini-card p,
.companion-card small,
.stat-box span,
.meal-summary span,
.profile-goals span,
.profile-identity p,
.workout-item p,
.range-labels,
.energy-meter small {
  color: var(--muted);
}

.stat-card strong {
  font-size: clamp(2rem, 3vw, 2.8rem);
  letter-spacing: -0.06em;
}

.companion-card {
  display: flex;
  align-items: center;
  gap: 14px;
}

.companion-avatar,
.avatar-large,
.mood-bubble {
  border-radius: 20px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(250, 188, 118, 0.18), rgba(91, 190, 120, 0.2));
  color: var(--text);
  font-weight: 800;
}

.companion-avatar {
  width: 62px;
  height: 62px;
  font-size: 2rem;
}

.signup,
.meals-card,
.profile-card,
.dashboard-main,
.side-panel {
  padding: 22px 24px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.signup-form {
  display: grid;
  gap: 18px;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(220px, 1fr));
  gap: 18px;
}

label {
  display: grid;
  gap: 8px;
  font-weight: 600;
  color: var(--text);
}

input {
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.9);
  border-radius: 14px;
  padding: 13px 14px;
  color: var(--text);
}

.submit-btn {
  justify-self: start;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 1.5fr 0.9fr;
  gap: 28px;
}

.energy-panel {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 20px;
  border-radius: 22px;
  background: linear-gradient(135deg, rgba(75, 162, 109, 0.08), rgba(166, 224, 180, 0.16));
  border: 1px solid rgba(75, 162, 109, 0.16);
}

.companion-figure {
  display: flex;
  align-items: center;
  gap: 14px;
}

.mood-bubble {
  width: 74px;
  height: 74px;
  font-size: 2.3rem;
}

.companion-figure h4 {
  margin: 4px 0 0;
  font-size: 1.7rem;
}

.companion-figure p {
  margin: 0;
  color: var(--muted);
}

.energy-meter {
  flex: 1;
  display: grid;
  align-content: center;
  gap: 10px;
}

.meter-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 700;
}

.meter-bar {
  width: 100%;
  height: 14px;
  background: rgba(73, 117, 90, 0.12);
  border-radius: 999px;
  overflow: hidden;
}

.meter-bar span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #72c791, #3abf86);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 16px;
  margin-top: 22px;
}

.stat-box {
  background: rgba(255,255,255,0.78);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 18px 16px;
  display: grid;
  gap: 8px;
}

.stat-box strong {
  font-size: 1.9rem;
  letter-spacing: -0.05em;
}

.steps-card {
  margin-top: 26px;
  border-radius: 20px;
  padding: 18px 16px;
  background: rgba(255,255,255,0.7);
  border: 1px solid var(--line);
}

.steps-card input[type='range'] {
  width: 100%;
  accent-color: var(--primary);
  margin-top: 8px;
  height: 10px;
}

.range-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;
}

.workout-list {
  display: grid;
  gap: 12px;
}

.workout-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.72);
}

.workout-item.done {
  background: rgba(117, 194, 138, 0.1);
  border-color: rgba(72, 161, 105, 0.18);
}

.workout-item strong,
.workout-item p {
  margin: 0;
}

.workout-item p {
  margin-top: 4px;
}

.meal-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 14px;
  margin-bottom: 18px;
}

.meal-summary > div {
  background: rgba(255,255,255,0.7);
  border-radius: 18px;
  border: 1px solid var(--line);
  padding: 16px 14px;
  display: grid;
  gap: 8px;
}

.meal-summary strong {
  font-size: 1.5rem;
  letter-spacing: -0.04em;
}

.meal-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.meal-item {
  background: rgba(255,255,255,0.75);
  border: 1px solid var(--line);
  border-radius: 18px;
  overflow: hidden;
}

.meal-item img {
  width: 100%;
  height: 160px;
  object-fit: cover;
}

.meal-item div {
  padding: 12px 14px 16px;
}

.meal-item h4,
.meal-item p {
  margin: 0;
}

.meal-item p {
  margin-top: 6px;
  color: var(--muted);
}

.profile-layout {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.profile-identity {
  display: flex;
  align-items: center;
  gap: 18px;
}

.avatar-large {
  width: 72px;
  height: 72px;
  font-size: 2rem;
  background: linear-gradient(135deg, rgba(89, 176, 115, 0.2), rgba(247, 178, 103, 0.18));
}

.profile-goals {
  display: grid;
  grid-template-columns: repeat(3, minmax(150px, 1fr));
  gap: 16px;
  flex: 1;
}

.profile-goals > div {
  border-radius: 16px;
  padding: 14px 12px;
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.7);
  display: grid;
  gap: 6px;
}

.profile-goals strong {
  line-height: 1.5;
}

@media (max-width: 900px) {
  .hero,
  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    gap: 16px;
  }

  .nav {
    flex-wrap: wrap;
    justify-content: center;
  }

  .field-grid,
  .stats-grid,
  .profile-goals,
  .meal-summary {
    grid-template-columns: 1fr;
  }

  .energy-panel {
    flex-direction: column;
  }
}

@media (max-width: 560px) {
  .app-shell {
    padding: 14px;
  }

  .hero,
  .signup,
  .meals-card,
  .profile-card,
  .dashboard-main,
  .side-panel {
    padding: 18px 16px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .hero-copy h2 {
    font-size: 2.4rem;
  }
}
